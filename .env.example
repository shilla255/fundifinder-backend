# Copy to .env and adjust. Never commit the real .env.
DJANGO_DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostGIS database (docker compose up -d db)
DATABASE_URL=postgis://fundi:fundi@localhost:5432/fundifinder

# Only needed on Windows/macOS if GeoDjango can't find GDAL/GEOS automatically.
# GDAL_LIBRARY_PATH=
# GEOS_LIBRARY_PATH=

# Google Sign-In: OAuth client IDs from Google Cloud Console (APIs & Services > Credentials).
# Comma-separated: include the Web, Android and iOS client IDs your apps use.
GOOGLE_OAUTH_CLIENT_IDS=

# Encryption key for NIDA numbers. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required when DJANGO_DEBUG=false. Changing it makes stored NIDA numbers unreadable.
FIELD_ENCRYPTION_KEY=
# Secret used to hash NIDA numbers for duplicate detection. Required when DJANGO_DEBUG=false.
HASH_PEPPER=

# Phone OTP login stays off until an SMS gateway is connected.
# With the console backend, codes are printed to the server log (development only).
PHONE_OTP_ENABLED=true
SMS_BACKEND=apps.notifications.sms.ConsoleSMSBackend
